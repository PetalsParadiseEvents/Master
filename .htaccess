# Petals Paradise Events - Security Headers
<IfModule mod_headers.c>
    # Prevent Clickjacking
    Header set X-Frame-Options "DENY"
    
    # Prevent MIME Sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection for older browsers
    Header set X-XSS-Protection "1; mode=block"
    
    # Enforce HTTPS (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (CSP)
    # Allows trusted CDNs for scripts, styles, and images used in the site
    # connect-src updated to allow Gemini AI API calls from the PHP backend
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net https://maps.googleapis.com https://cdn.emailjs.com https://api.emailjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https://images.unsplash.com https://maps.gstatic.com https://maps.googleapis.com https://www.petalsparadiseevents.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.emailjs.com https://maps.googleapis.com https://generativelanguage.googleapis.com https://www.petalsparadiseevents.com;"

    # Permissions Policy - Disable unused browser capabilities
    Header set Permissions-Policy "geolocation=(self 'https://maps.googleapis.com'), camera=(), microphone=(), payment=(), usb=()"
</IfModule>

# ─────────────────────────────────────────────────────────────
# Environment Variables (Secure API Keys)
# ─────────────────────────────────────────────────────────────
# IMPORTANT: API keys MUST NOT be hardcoded in version control.
# Set via ONE of these secure methods:
#
# Option A — cPanel Hosting:
#   Go to cPanel → Software → PHP Config → Environment Variables
#   Add: Name = GEMINI_API_KEY, Value = your_actual_key
#
# Option B — .env file (local dev):
#   Create .env in project root (already in .gitignore)
#   GEMINI_API_KEY=your_actual_key
#   Load with: putenv() or vlucas/phpdotenv
#
# Option C — Direct server injection (VPS/Dedicated):
#   Add to /etc/environment or Apache/Nginx vhost config:
#   SetEnv GEMINI_API_KEY your_actual_key
#
# The application reads the key via PHP's getenv('GEMINI_API_KEY')
# in api/config.php, never from source code.
# ─────────────────────────────────────────────────────────────

# Disable Directory Browsing
Options -Indexes

# Protect .htaccess file itself
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Protect PHP config files from direct browser access
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>
